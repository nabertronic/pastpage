{
  "name": "pastpage",
  "version": "1.0.11",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "description": "PastPage source recovery browser extension workspace.",
  "license": "MIT",
  "scripts": {
    "dev": "pnpm --dir extension dev",
    "dev:firefox": "pnpm --dir extension dev:firefox",
    "build": "pnpm --dir extension build",
    "build:firefox": "pnpm --dir extension build:firefox",
    "deploy": "node ./scripts/deploy.mjs",
    "deploy:dry-run": "node ./scripts/deploy.mjs --dry-run",
    "zip": "pnpm --dir extension zip",
    "zip:firefox": "pnpm --dir extension zip:firefox",
    "test": "pnpm --dir extension test",
    "typecheck": "pnpm --dir extension typecheck"
  },
  "workspaces": [
    "extension"
  ]
}
